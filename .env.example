# Docker Compose project name. Without it Compose names the project after
# the working directory, so renaming or cloning the folder silently points
# the stack at a different set of volumes — the dev database looks empty
# while the old one sits there orphaned. Pinning it keeps `dienteazul_pgdata`
# and `dienteazul_storage_data` wherever the checkout lives.
COMPOSE_PROJECT_NAME=dienteazul

# Database (for Docker Compose)
POSTGRES_DB=dental_clinic
POSTGRES_USER=dental
POSTGRES_PASSWORD=your_secure_password_here

# Backend (for local development without Docker)
# DATABASE_URL is auto-constructed in docker-compose.yml
DATABASE_URL=postgresql+asyncpg://dental:your_secure_password_here@localhost:5432/dental_clinic

# Security - Generate with: openssl rand -hex 32
#
# With ENVIRONMENT=production the backend REFUSES TO START if this is
# shorter than 32 characters, still contains the placeholder text below,
# or is not plausibly random
# (see docs/adr/0029-security-invariants-with-chokepoints.md).
SECRET_KEY=your_secret_key_here_use_openssl_rand_hex_32

# Independent secret for the public-budget verification cookie
# (see docs/adr/0006-budget-public-link-2-factor-auth.md).
# Generate with: openssl rand -hex 32. Falls back to SECRET_KEY in dev
# when unset; under ENVIRONMENT=production it is MANDATORY and must
# differ from SECRET_KEY, or the backend refuses to start — a leak of
# the staff-JWT key must not also open every patient's budget.
BUDGET_PUBLIC_SECRET_KEY=

# Environment
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000

# Logging
#
# How much is written: DEBUG, INFO, WARNING, ERROR or CRITICAL. Anything
# else and the backend refuses to start, rather than running at a level
# that drops every line.
LOG_LEVEL=INFO
# Where a copy of the log is kept. Empty — the default — writes only to
# stdout, which is what `docker-compose logs` and the platform collector
# read. Point it at a directory and the same lines are appended to
# <LOG_DIR>/dienteazul.log as well; it is created if missing, and a
# directory that cannot be written warns and falls back to stdout.
# The control panel's Logs → Aplicación reads this file
# (GET /api/v1/ops/logs); with it empty the panel has nothing to show.
# docker-compose.yml and docker-compose.coolify.yml default it to
# /var/log/dienteazul, on the error_logs volume.
#
# In Docker the path is INSIDE the container, so it needs a volume to
# survive a restart — add one to the backend service, e.g.
#   - ./logs:/app/logs
# One writer per directory: with several backends (ADR 0051) each rolls
# the file over on its own. Give each replica its own LOG_DIR, or leave
# this empty and collect stdout.
LOG_DIR=
# Rollover threshold in bytes (10 MiB) and how many rolled files to keep
# beside the live one, so the set stays under ~60 MiB.
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Where the requests that ended in a server error are kept, one JSON line
# each: this is what the control panel reads at GET /api/v1/ops/errors
# (ADR 0060). Unlike LOG_DIR it always writes — an empty value would
# leave the operator with nothing to look at.
#
# The image creates this directory and gives it to the app's user, and
# docker-compose mounts the `error_logs` volume on it so the occurrences
# survive a restart. Changing it to a path the container cannot write
# logs the reason and the panel stays empty.
ERROR_LOG_DIR=/var/log/dienteazul
# Retention is the rotation: bytes per file, and files kept beside the
# live one. This replaced the thirty-day purge the old table did.
ERROR_LOG_MAX_BYTES=5242880
ERROR_LOG_BACKUP_COUNT=3

# Tenant custody and regime — see docs/adr/0023-privacy-policy-and-custody-modes.md
#
#   managed  we run the deployment and hold its keys (default)
#   self     the customer runs it; no operator of ours can reach the data
#   byok     we run it, the customer holds the keys — NOT IMPLEMENTED yet
#
# NOTE: the modes describe who holds what, not an enforced control.
# `managed` names break-glass operator access and that mechanism does not
# exist yet — operator access is currently standing. `byok` is out of
# scope for this stage. Both log a warning at startup.
#
# It is also half of the commercial pairing checked when a clinic is
# created: `basic` and `medium` are only sold `managed`; every other tier
# may be self, managed or byok. See app/core/privacy/tiers.py.
TENANT_CUSTODY_MODE=managed
# ISO 3166-1 alpha-2, comma separated. Selects which government documents
# the copilot's PHI boundary treats as identifiers.
TENANT_JURISDICTIONS=MX,ES
# Where the data physically lives (e.g. mx-central, eu-west, on-prem).
# Empty resolves to `on-prem` under `self` and `unspecified` otherwise.
TENANT_DATA_RESIDENCY=
# Destinations this deployment has contracted for, comma separated
# (openai, kapso, aeat, smtp). Default-deny: empty means every module
# that calls out is reported at boot. Reported, not blocked — see
# docs/adr/0027-egress-is-declared-in-the-manifest.md
TENANT_EGRESS_ALLOWED=

# Shared with the operator's control plane (ADR 0049). It signs the tokens
# that open /api/v1/ops, where usage and access per clinic are read —
# sizes, counts and identifiers, never content — along with the server
# errors and the application log (Logs). Empty switches those routes off,
# and they are always off under TENANT_CUSTODY_MODE=self.
# At least 32 characters. The same value goes in control/.env as
# CONTROL_DEV_PLANE_SECRET (development) or in the panel's Ambientes page
# (production; under Coolify, set it in its Environment tab).
# Generate with: openssl rand -hex 32
CONTROL_PLANE_SECRET=

# Frontend
API_BASE_URL=http://localhost:8000

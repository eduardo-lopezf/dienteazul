# Pinned to a version and its digest (the multi-arch index), not the floating
# `24-alpine`: a tag that is pulled once sits wherever it was that day. To
# move it, change this one line. The weekly audit compares the digest with
# what `node:24-alpine` points at and fails when the pin falls behind; a
# move to another major also means changing that tag in
# .github/workflows/security-audit.yml.
ARG NODE_IMAGE=node:24.21.0-alpine3.24@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1

FROM ${NODE_IMAGE} AS builder

WORKDIR /app

COPY frontend/package*.json ./
RUN npm install --no-audit --no-fund

COPY backend/app/modules /module_layers

COPY frontend/ ./

ENV NODE_OPTIONS="--max-old-space-size=4096"
RUN npm run build


# ---------------------------------------------------------------------------
# runtime-files — the filesystem the server runs on, before it is flattened.
#
# Production runs `node .output/server/index.mjs` and nothing else. npm,
# yarn and corepack come with the Node image and are never called there,
# but an image scanner counts what npm bundles: 21 of the 22 findings Docker
# Scout reported on this image, none of them from the application.
#
# The 22nd was zlib — CVE-2026-85091, a heap overflow in its non-blocking
# gz* writes, zlib 1.3.1.2 through 1.3.2. Alpine fixed it in 1.3.2-r1; the
# Node image pinned above was built before that and ships 1.3.2-r0. Named
# with its version so the build fails rather than quietly keeping the old
# package. That line goes when the pin moves to an image that carries it.
# ---------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS runtime-files

RUN apk add --no-cache 'zlib>=1.3.2-r1'

RUN rm -rf /usr/local/lib/node_modules /opt/yarn-* \
    /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
    /usr/local/bin/yarn /usr/local/bin/yarnpkg


# ---------------------------------------------------------------------------
# The same filesystem as one layer, with the built application on top.
#
# Removing files above is not enough by itself: they stay in the base
# image's layer, and a scanner reads layers. Copying the filesystem into an
# empty image leaves no layer that ever held them. That copy drops the
# image's metadata, so what matters of it is declared again; the Node
# image's entrypoint only decides whether to prefix `node`, and the command
# below already does.
#
# Not root: `node` (uid 1000) ships with the image. The server binds 3000
# and writes nothing to disk.
# ---------------------------------------------------------------------------
FROM scratch

COPY --from=runtime-files / /

ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3000

WORKDIR /app

COPY --from=builder /app/.output /app/.output

USER node

EXPOSE 3000

CMD ["node", ".output/server/index.mjs"]
